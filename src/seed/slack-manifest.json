{
  "display_information": {
    "name": "liquen",
    "description": "Your org's delegate harness",
    "background_color": "#1a1d21"
  },
  "features": {
    "bot_user": {
      "display_name": "liquen",
      "always_online": true
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "member_joined_channel",
        "member_left_channel",
        "channel_left",
        "group_left",
        "channel_created",
        "channel_deleted",
        "group_deleted",
        "pin_added",
        "pin_removed",
        "channel_shared",
        "channel_unshared",
        "shared_channel_invite_received",
        "shared_channel_invite_accepted",
        "shared_channel_invite_approved",
        "shared_channel_invite_declined",
        "shared_channel_invite_requested",
        "channel_id_changed",
        "channel_history_changed",
        "group_history_changed",
        "im_history_changed",
        "im_created",
        "call_rejected"
      ],
      "user_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "member_joined_channel",
        "member_left_channel",
        "pin_added",
        "pin_removed"
      ]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
