// config.jsonc — the org's declaration: every harness knob (the catalog, DESIGN §9).
// The system never writes this file — git is its history, boot compiles it into the
// registry. A key left out takes its default; an unknown key is a boot error.
{
  // harness machinery — every deployment works on the defaults
  "system": {
    // cap on stop() awaiting an in-flight turn
    "stopTimeoutMs": 5000,
    // a bash call's wall cap unless the model asks for another
    "bashTimeoutMs": 120000,
    // turn-lease TTL; an older lease is stolen (the crash signal)
    "lockTtlMs": 120000,
    // slow outer retries after the SDK's own fast ones
    "retryDelaysMs": [5000, 20000],
    // est. tokens of raw event JSON (~1.8x the prompt) before a checkpoint runs
    "compactAt": 50000,
    // est. tokens a checkpoint leaves uncovered
    "keepRecent": 20000,
    // history query cap — the prompt's size guard
    "windowLimit": 500,
    // echo settle before the mirror's fan-in copies
    "mirrorSettleMs": 1000,
    // how far back an echo may claim an unclaimed CC
    "mirrorClaimMs": 60000,
    // how long a world message waits for the rest of its burst before a turn runs
    "debounceMs": 5000
  },
  // this deployment's identity — the clock, the backlog, and every agent's defaults
  "org": {
    // the org's clock (IANA) — every rendered stamp, cron and sleep span reads it
    "timezone": "America/Argentina/Buenos_Aires",
    // parked until the i18n seam — render is English for now
    "locale": "es_AR",
    // backlog an agent inherits at boot; lower it to come up quietly
    "backlogHours": 24,
    // every agent's defaults — an agents.<name> entry re-declares these, key by key
    "agent": {
      // the model an agent runs on
      "model": "claude-sonnet-5",
      // reasoning effort (low|medium|high|xhigh|max); null ⇒ the model decides
      "effort": null,
      // output cap per model call
      "maxTokens": 64000,
      // model provider (the transport seam); null ⇒ Anthropic
      "provider": "anthropic",
      // the tools offered to the model, by name — built-ins and exec tools (bash, MCP) alike; null ⇒ every tool the deployment has. A coding-agent deployment drops "send"
      "tools": ["send", "search", "schedule", "cancel", "bash"],
      // permission policy: first match decides (allow|ask|deny); * matches any tool; connection/conversation pin a rule to where a send lands
      "rules": [{ "tool": "send", "action": "ask" }, { "tool": "*", "action": "allow" }],
      // attention: a conversation stays hot this long after the agent's own last word
      "engagedMinutes": 15,
      // attention: an ambient pile this deep wakes the agent before the interval does
      "digestAfterMessages": 25,
      // attention: how often ambient conversations are looked at — the idle cadence
      "digestMinutes": 15,
      // attention: org-clock span "from-to" the ambient world waits out; null ⇒ never sleeps
      "sleepHours": "23-8"
    }
  },
  // media processors — broker-side commands that derive text from bytes (§5)
  "processors": {
    // shell command, audio bytes on stdin → transcript on stdout — e.g. "processors/qwen-asr/transcribe.sh" (root-relative; see its README); null ⇒ no transcription
    "audio": "processors/qwen-asr/transcribe.sh"
  },
  // the roster: every key is an agent — overrides of org.agent, plus declared handles
  "agents": {
    "matias": { "effort": "low" }
  },
  // the connectors' knobs — a subsection per connector, validated by its owner
  "connections": {
    // google — the oauth door and the calendar poll
    "google": {
      // calendars the poll watches on every grant; "primary" = the account's own
      "calendars": ["primary"],
      // the oauth door's localhost port (hosted callback or the account door)
      "oauthPort": 8791,
      // OAuth scopes a new grant asks for (a /start ?scopes= overrides per-link)
      "scopes": ["openid", "email", "https://www.googleapis.com/auth/calendar"]
    },
    // slack — ingest (HTTP mode), the hosted oauth door, dispatch
    "slack": {
      // the HTTP-mode ingest port (Socket Mode needs none)
      "ingestPort": 8789,
      // the hosted oauth door's port
      "oauthPort": 8790,
      // the org leg: scopes the bot token is granted (the app manifest asks for these)
      "botScopes": [
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "channels:read",
        "users:read",
        "chat:write"
      ],
      // the per-principal leg: scopes a member's own token is granted
      "userScopes": [
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "channels:read",
        "users:read",
        "chat:write",
        "groups:read",
        "im:read",
        "mpim:read",
        "search:read",
        "files:read"
      ]
    },
    // whatsapp — the whatsmeow bridge's mu side (ingest, dispatch, pairing)
    "whatsapp": {
      // where the bridge POSTs webhook batches
      "ingestPort": 8793,
      // the whatsmeow bridge's base URL
      "bridgeUrl": "http://localhost:8081"
    },
    // github — webhook ingest and comment dispatch
    "github": {
      // where GitHub (or `gh webhook forward`) delivers
      "ingestPort": 8788,
      // event types the ingest maps; anything else is acknowledged and dropped
      "events": [
        "issue_comment",
        "issues",
        "pull_request",
        "pull_request_review",
        "pull_request_review_comment"
      ]
    }
  }
}
